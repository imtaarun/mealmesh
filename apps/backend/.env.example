DATABASE_URL="postgresql://mealmesh:mealmesh@localhost:5432/mealmesh?schema=public"
PORT=3000

# "fixture" (default) returns canned data, no network. "claude" uses the real API.
AI_PROVIDER=fixture
ANTHROPIC_API_KEY=

# Google and Apple sign-in (docs/oauth-setup.md). Comma-separated: every client ID whose
# ID tokens we accept. Leave empty to turn that provider off.
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=com.mealmesh.app

  {
    "id": "butter-chicken",
    "title": "Butter Chicken",
    "servings": 4,
    "prepMinutes": 15,
    "cookMinutes": 25,
    "difficulty": "medium",
    "cuisines": ["indian"],
    "dietTags": ["gluten_free", "high_protein"],
    "ingredients": [
      { "ingredientId": "chicken-thigh", "quantity": 600, "unit": "g" },
      { "ingredientId": "butter", "quantity": 3, "unit": "tbsp" },
      { "ingredientId": "onion", "quantity": 1, "unit": "piece" },
      { "ingredientId": "garlic", "quantity": 3, "unit": "clove" },
      { "ingredientId": "ginger", "quantity": 1, "unit": "piece", "note": "grated" },
      { "ingredientId": "tomato-paste", "quantity": 2, "unit": "tbsp" },
      { "ingredientId": "canned-diced-tomatoes", "quantity": 1, "unit": "can" },
      { "ingredientId": "heavy-cream", "quantity": 120, "unit": "ml" },
      { "ingredientId": "garam-masala", "quantity": 2, "unit": "tsp" },
      { "ingredientId": "cumin-ground", "quantity": 1, "unit": "tsp" },
      { "ingredientId": "turmeric", "quantity": 0.5, "unit": "tsp" },
      { "ingredientId": "chili-powder", "quantity": 1, "unit": "tsp" },
      { "ingredientId": "salt", "quantity": 1, "unit": "pinch" },
      { "ingredientId": "basmati-rice", "quantity": 300, "unit": "g", "note": "for serving", "optional": true }
    ],
    "instructions": [
      { "step": 1, "text": "Cut the chicken thighs into bite-sized pieces and season lightly with salt." },
      { "step": 2, "text": "Melt half the butter in a large pan over medium heat. Add the onion and cook until soft and golden.", "timerSeconds": 300 },
      { "step": 3, "text": "Stir in the garlic and ginger and cook until fragrant." },
      { "step": 4, "text": "Add the garam masala, cumin, turmeric, and chili powder. Toast the spices for 30 seconds, stirring constantly." },
      { "step": 5, "text": "Add the tomato paste and canned tomatoes. Simmer, stirring occasionally, until the sauce thickens slightly.", "timerSeconds": 600 },
      { "step": 6, "text": "Add the chicken and simmer until cooked through.", "timerSeconds": 600 },
      { "step": 7, "text": "Stir in the remaining butter and the cream. Simmer gently for 2 more minutes and adjust salt to taste.", "timerSeconds": 120 },
      { "step": 8, "text": "Serve hot over basmati rice." }
    ]
  },

{
  "name": "mealmesh",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev:mobile": "pnpm --filter @mealmesh/mobile dev",
    "dev:backend": "pnpm --filter @mealmesh/backend dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:migrate": "pnpm --filter @mealmesh/backend db:migrate",
    "db:seed": "pnpm --filter @mealmesh/backend db:seed",
    "test:demo": "pnpm --filter @mealmesh/domain build && pnpm --filter @mealmesh/backend test:demo",
    "test:security": "pnpm --filter @mealmesh/domain build && pnpm --filter @mealmesh/backend test:security"
  },
  "devDependencies": {
    "turbo": "^2.1.0",
    "typescript": "^5.6.0"
  },
  "pnpm": {
    "overrides": {
      "qs@<6.16.0": "6.16.0",
      "body-parser@<1.20.8": "1.20.8",
      "multer@<2.4.0": "2.4.0",
      "proxy-addr@<2.0.8": "2.0.8"
    }
  }
}
